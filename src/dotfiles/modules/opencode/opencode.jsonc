{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "mcp": {
    "cloudflare": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true
    }
  },
  // OpenCodeにビルトインされている全てのLSPサーバーを有効化
  // https://opencode.ai/docs/ja/lsp
  "lsp": true
}
